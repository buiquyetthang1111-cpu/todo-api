# Todo API – test requests for the VS Code "REST Client" extension
# (extension id: humao.rest-client). Click "Send Request" above each request.
# Start the server first:  npm start

@baseUrl = http://localhost:3000

###############################################################################
# HAPPY PATHS
###############################################################################

### 1. Create a todo (201 + Location header + createdAt/updatedAt)
# @name createTodo
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Write API documentation",
  "description": "OpenAPI + README examples",
  "state": "todo"
}

### The id of the todo created above is reused by the requests below
@todoId = {{createTodo.response.body.$.id}}

### 2. Create a todo with only a title (state defaults to "todo")
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Only a title",
  "dueDate": "2026-12-01"
}

### 3. List all todos (200)
GET {{baseUrl}}/todos

### 4. List todos filtered by state (200)
GET {{baseUrl}}/todos?state=todo

###
GET {{baseUrl}}/todos?state=doing

###
GET {{baseUrl}}/todos?state=done

### 4b. List todos as CSV (200, Content-Type: text/csv)
GET {{baseUrl}}/todos
Accept: text/csv

###
GET {{baseUrl}}/todos?state=done
Accept: text/csv

### 4c. Explicit JSON, and a client that prefers CSV but also takes JSON
GET {{baseUrl}}/todos
Accept: application/json

###
GET {{baseUrl}}/todos
Accept: application/json;q=0.5, text/csv;q=0.9

### 5. Get a single todo (200)
GET {{baseUrl}}/todos/{{todoId}}

### 6. Update a todo with PUT – partial body, full object returned (200)
PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json

{
  "state": "doing"
}

### 7. Update several fields at once with PUT (200)
PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json

{
  "title": "Write API documentation (v2)",
  "description": null,
  "state": "done",
  "dueDate": "2026-11-30T12:00:00Z"
}

### 8. Update with PATCH (200)
PATCH {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json

{
  "state": "todo"
}

### 9. Delete a todo (204, no body)
DELETE {{baseUrl}}/todos/{{todoId}}

###############################################################################
# CLIENT ERRORS
###############################################################################

### E1. 400 – malformed JSON body
POST {{baseUrl}}/todos
Content-Type: application/json

{ "title": "broken json"

### E2. 400 – title missing
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "description": "no title here"
}

### E3. 400 – title is empty / whitespace
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "   "
}

### E4. 400 – title has the wrong type
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": 123
}

### E5. 400 – invalid state
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Bad state",
  "state": "finished"
}

### E6. 400 – invalid dueDate
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Bad date",
  "dueDate": "next friday"
}

### E7. 400 – unknown / read-only field
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "Sneaky",
  "id": "my-own-id"
}

### E8. 400 – body is a JSON array, not an object
POST {{baseUrl}}/todos
Content-Type: application/json

[ { "title": "array" } ]

### E9. 400 – no body at all
POST {{baseUrl}}/todos
Content-Type: application/json

### E10. 415 – wrong Content-Type
POST {{baseUrl}}/todos
Content-Type: text/plain

title=hello

### E11. 400 – invalid state filter on the list endpoint
GET {{baseUrl}}/todos?state=finished

### E12. 404 – todo not found (GET)
GET {{baseUrl}}/todos/1000

### E13. 404 – todo not found (PUT)
PUT {{baseUrl}}/todos/1000
Content-Type: application/json

{
  "state": "doing"
}

### E14. 404 – todo not found (DELETE)
DELETE {{baseUrl}}/todos/1000

### E15. 400 – PUT with invalid state (use a real id from request 1 or 3)
PUT {{baseUrl}}/todos/{{createTodo.response.body.$.id}}
Content-Type: application/json

{
  "state": "archived"
}

### E16. 400 – PUT with an empty object
PUT {{baseUrl}}/todos/{{createTodo.response.body.$.id}}
Content-Type: application/json

{}

### E17. 405 – method not allowed on a known path (Allow header is returned)
DELETE {{baseUrl}}/todos

### E18. 404 – unknown route
GET {{baseUrl}}/unknown

### E19. 406 – Accept header allows neither JSON nor CSV
GET {{baseUrl}}/todos
Accept: application/xml

### E20. 400 – invalid state filter is still a JSON error when CSV is requested
GET {{baseUrl}}/todos?state=finished
Accept: text/csv

### API documentation (open in a browser): http://localhost:3000/doc
### Raw OpenAPI document
GET {{baseUrl}}/doc/openapi.json
